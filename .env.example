# ─────────────────────────────────────────────
#  Stylist Concierge — Environment Variables
#  Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# ── LLM Provider (change these two to switch models) ──
LLM_PROVIDER=groq                                     # groq | openai | anthropic | google
LLM_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct
AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=2048

# ── API Keys (only the active provider needs a key) ──
GROQ_API_KEY=gsk_your_groq_key_here
OPENAI_API_KEY=sk-your_openai_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
GOOGLE_API_KEY=your_google_key_here

# ── Embeddings ───────────────────────────────
EMBEDDING_PROVIDER=openai                             # openai | local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ── Qdrant (matches docker-compose) ──────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=fashion_catalog

# ── PostgreSQL (matches docker-compose) ──────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=stylist
POSTGRES_PASSWORD=stylist_secret
POSTGRES_DB=stylist_db
DATABASE_URL=postgresql+asyncpg://stylist:stylist_secret@localhost:5432/stylist_db

# ── Redis (matches docker-compose) ───────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ── Cache ────────────────────────────────────
CACHE_SIMILARITY_THRESHOLD=0.92   # 0.92 = very similar prompts only
CACHE_TTL_SECONDS=3600            # 1 hour

# ── Scraper ──────────────────────────────────
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT=30000
SCRAPER_MAX_RETRIES=3
SCRAPER_DELAY_MIN=1.0
SCRAPER_DELAY_MAX=3.0